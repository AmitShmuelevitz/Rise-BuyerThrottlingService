{
  "title": "Buyer throttling",
  "uid": "buyer-throttling",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throttle rate per buyer (evaluator)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (buyer) (evaluator_throttle_rate)",
          "legendFormat": "{{buyer}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Failure rate per buyer (last window)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (buyer) (evaluator_window_failure_rate)",
          "legendFormat": "{{buyer}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Timeout rate per buyer (last window)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (buyer) (evaluator_window_timeout_rate)",
          "legendFormat": "{{buyer}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Calls per second per buyer (all pods)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (buyer) (rate(buyer_calls_total[30s]))",
          "legendFormat": "{{buyer}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throttled requests per second per buyer",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (buyer) (rate(buyer_skipped_total[30s]))",
          "legendFormat": "{{buyer}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Throttle rate as seen by each pod",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "throttle_rate",
          "legendFormat": "{{instance}} {{buyer}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Evaluator leader",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "evaluator_is_leader",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}